# Server
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_uri

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=your_secret_key

# Gmail account + app password used for application notification emails
EMAIL_USER=your_email
EMAIL_PASS=your_app_password

# Optional: comma-separated list of allowed frontend origins.
# Leave unset to allow all origins (current behaviour).
# Example: CORS_ORIGIN=https://job-board-seven-beige.vercel.app
CORS_ORIGIN=
